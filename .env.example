# Environment: dev | staging | prod
HUB_ENV=dev
PORT=8787
# Public URL of the Hub as seen by browsers and Moodle (no trailing slash)
HUB_BASE_URL=http://localhost:8787

# Storage: file (local dev, JSON in DATA_DIR) | firestore (staging/prod)
HUB_STORE=file
DATA_DIR=.data
# FIRESTORE_PROJECT=gamehub-514101
# FIRESTORE_DATABASE=(default)

# Required outside dev. Protects /api/v1/admin/* and /admin/setup
# ADMIN_TOKEN=change-me

# Signing keys (JSON array of private RS256 JWKs with "kid"). Outside dev this
# must come from Secret Manager. In dev a key is generated into DATA_DIR.
# HUB_SIGNING_KEYS=[{...}]

# Game catalog file
GAMES_FILE=config/games.json

# Per-game shared secret used by game backends to sign result tokens (HS256).
# Name: GAME_SECRET_<GAME_ID upper-cased, non-alphanumerics replaced by _>
# GAME_SECRET_K26GAME1=...
