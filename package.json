{
  "name": "unigame-hub",
  "version": "0.1.0",
  "private": true,
  "description": "UniGame Hub - LTI 1.3 Advantage gateway connecting Moodle with GCP/Firebase games (SSO + grade sync)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
